PORT=3001
NODE_ENV=development

# MongoDB — use Atlas free tier (https://mongodb.com/cloud/atlas) or local
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lesson-builder

# JWT — generate a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# Google Gemini — get a free key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
